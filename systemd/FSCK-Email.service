[Unit]
Description=FSCK Boot Email
Requires=systemd-fsck-root.service
Wants=network-online.target
After=systemd-fsck-root.service network-online.target multi-user.target
StartLimitIntervalSec=15min
StartLimitBurst=10

[Service]
Type=oneshot
EnvironmentFile=/etc/fsck-email.env
ExecStart=/usr/bin/python3 /root/Git/FSCK-Email/fsck_boot_email.py
StandardOutput=append:/root/Git/FSCK-Email/Log/log
StandardError=inherit
Restart=on-failure
RestartSec=30s
TimeoutStartSec=60s

[Install]
WantedBy=multi-user.target
